{
    "version": "0.2.0",
    "configurations": [
        {
            // Same arguments as Properties/launchSettings.json: stop whatever earlier runs left behind, 10x faster
            "name": "SemiSimulator (speed 10, terminate previous runs)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net8.0/SemiSimulator.dll",
            "args": [
                "--terminateonstart",
                "--speed", "10"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "env": {
                // Environment variables override appsettings.json and line.json ("__" separates the levels);
                // the command line overrides them. Uncomment to target another environment:
                // "SEMISIM_ClientConfiguration__Connection__EnvironmentAddress": "https://<mes-host>",
                // "SEMISIM_ClientConfiguration__Authentication__SecurityAccessToken": "<token: never commit it>",
                // "SEMISIM_Line__Order__MaxOrders": "20",
                // Another line file than line.json (needed to change steps: their names contain spaces):
                // "SEMISIM_LINE_FILE": "${workspaceFolder}/lines/other-plant.json"
            }
        }
    ]
}
